# Copy to .env.local for local development:
#   copy .env.local.example .env.local   (Windows)
#   cp .env.local.example .env.local     (macOS/Linux)

# ─── Local Docker MySQL (npm run db:up) ─────────────────────────────────────

DATABASE_URL=mysql://menurio:menurio_dev@127.0.0.1:3307/menurio

# ─── Auth (required) ─────────────────────────────────────────────────────────

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Optional Google OAuth (https://console.cloud.google.com)
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reserved for MFA enrollment once that optional feature is enabled.
MFA_ENCRYPTION_KEY=

# Production platform: https://menurio.store
# PLATFORM_HOSTNAME=menurio.store

# ─── Public URLs ───────────────────────────────────────────────────────────

NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PLATFORM_HOSTNAME=localhost
PLATFORM_ADMIN_EMAILS=

# ─── S3 (optional locally — uploads fail without real credentials) ───────────

S3_ENDPOINT=https://s3.beget.com
S3_REGION=us-east-1
S3_BUCKET=menurio-uploads-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=http://localhost:3000

# ─── Privacy ───────────────────────────────────────────────────────────────

ANALYTICS_IP_SALT=local-dev-salt-change-me
