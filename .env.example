# Menurio — Environment Variables
# Copy to .env.local for development. Never commit secrets.

# ─── Database (Beget MySQL 8.4 in production) ────────────────────────────────
#
# Option A — single URL (recommended for Vercel):
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
#
# Option B — discrete vars (Beget panel):
# DB_HOST=your-beget-mysql-host.beget.tech
# DB_PORT=3306
# DB_NAME=your_database
# DB_USER=your_user
# DB_PASSWORD=your_password

DATABASE_URL=mysql://menurio:menurio_dev@127.0.0.1:3307/menurio

# ─── Auth (required) ─────────────────────────────────────────────────────────

AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reserved for MFA enrollment once that optional feature is enabled.
# Do not set a placeholder value in production; use a high-entropy secret.
MFA_ENCRYPTION_KEY=

# ─── Public URLs ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PLATFORM_HOSTNAME=localhost

# Production:
# NEXT_PUBLIC_APP_URL=https://menurio.store
# NEXT_PUBLIC_PLATFORM_URL=https://menurio.store
# PLATFORM_HOSTNAME=menurio.store
# AUTH_URL=https://menurio.store

# Comma-separated emails granted platform admin access
PLATFORM_ADMIN_EMAILS=

# ─── S3-compatible storage (Beget S3 in production) ──────────────────────────

S3_ENDPOINT=https://s3.beget.com
S3_REGION=us-east-1
S3_BUCKET=menurio-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ─── Security / Privacy ────────────────────────────────────────────────────

ANALYTICS_IP_SALT=change-me-in-production

# ─── PWA / Web Push (PRO / PRO+) ───────────────────────────────────────────

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@menurio.store

# Vercel Cron auth for scheduled notifications (PRO+)
CRON_SECRET=
